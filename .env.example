# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=docparser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=docparser
DATABASE_URL=postgresql+asyncpg://\:\@\:\/
# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://\:REDIS_QUEUE_NAME=arq:queue

# === MinIO (Object Storage) ===
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw-files
MINIO_BUCKET_RESULTS=parse-results
MINIO_BUCKET_IMAGES=parse-images

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_WORKERS=4
CORS_ORIGINS=*

# === Async Worker ===
WORKER_CONCURRENCY=2
WORKER_QUEUE=arq:queue

# === GPU Inference Service ===
GPU_DEVICE=cuda
GPU_MODEL_BASE=/models
INFERENCE_SERVICE_URL=http://gpu-inference:8001

# === LibreOffice / Pandoc Tools ===
LIBREOFFICE_HOST=tools
LIBREOFFICE_PORT=8100
PANDOC_HOST=tools
PANDOC_PORT=8200

# === File Paths ===
UPLOAD_DIR=/data/uploads
RESULT_DIR=/data/results
TEMP_DIR=/tmp
MODEL_CACHE_DIR=/models/cache

# === Auth ===
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRATION_SECONDS=86400

# === Frontend ===
VITE_API_BASE_URL=http://localhost:8000
