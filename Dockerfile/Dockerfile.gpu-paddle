# ============================================================
# Dockerfile.gpu-paddle — PaddleOCR
# ============================================================

FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.gpu-paddle.txt .
RUN pip install --no-cache-dir -r requirements.gpu-paddle.txt

COPY gpu-paddle/ .

EXPOSE 8002

CMD ["python3", "inference_server.py"]
